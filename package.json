{
  "name": "aperture-cad",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Compute-only WebGPU CAD workbench with DXF block libraries, graphical definition editing, INSERT tools, annotations and paper layouts",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:gpu": "python tests/browser.py",
    "check": "node tools/check.mjs",
    "test:dom": "python tests/browser.py --dom-only",
    "test:font-reference": "python tests/font_reference.py",
    "test:wgsl": "node tools/native-webgpu.mjs",
    "test:native": "node tools/native-webgpu.mjs --execute --stress",
    "benchmark:native": "node tools/profile-release.mjs",
    "test:workspace": "python tests/workspace-ui.py",
    "test:blocks": "node --test tests/blocks.test.mjs",
    "test:blocks-ui": "python tests/blocks-ui.py",
    "test:blocks-interop": "python tests/blocks_interop.py"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "MIT"
}
